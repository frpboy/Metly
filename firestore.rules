rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user data: watchlist and portfolio live under users/<uid>/...
    // and are readable/writable only by that signed-in user. Writes are
    // validated so a buggy or hostile client cannot store junk.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validWatchlist() {
      let d = request.resource.data;
      return d.keys().hasOnly(['metal', 'targetPrice', 'addedAt'])
        && d.metal in ['gold', 'silver']
        && d.targetPrice is number
        && d.targetPrice > 0
        && d.targetPrice < 1000000000000
        && d.addedAt is string;
    }

    function validPortfolio() {
      let d = request.resource.data;
      return d.keys().hasOnly(['metal', 'amount', 'avgPrice', 'addedAt'])
        && d.metal in ['gold', 'silver']
        && d.amount is number
        && d.amount > 0
        && d.amount < 1000000000000
        && d.avgPrice is number
        && d.avgPrice > 0
        && d.avgPrice < 1000000000000
        && d.addedAt is string;
    }

    match /users/{userId} {
      // The user document itself holds no fields yet; allow only its
      // existence for future profile data, scoped to the owner.
      allow read, write: if isOwner(userId);

      match /watchlist/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validWatchlist();
      }

      match /portfolio/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validPortfolio();
      }
    }
  }
}
