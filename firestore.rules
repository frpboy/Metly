rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user data: watchlist and portfolio live under users/<uid>/...
    // and are readable/writable only by that signed-in user.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /watchlist/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /portfolio/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
